<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Node runs in its own process so a Node OOM/crash is isolated from the UI process. -->
        <service
            android:name="com.legion.orion.runtime.node.NodeRuntimeService"
            android:process=":node"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
